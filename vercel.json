{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bun run build:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://www.josephtabalonjr.com/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "josephtabalonjr.com"
        }
      ]
    }
  ]
}
